<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
	<?include ../Includes.wxi?>

	<Fragment>
		<!-- 安装目录固定在系统盘的 Program Files。管理代理、救援包和本地修复都按这个位置工作，
				 允许用户改目录会让它们全部失效，所以不读注册表记住的旧目录，也不接受命令行传入的目录。
				 ProgramFiles64Folder / CommonAppDataFolder 由 Windows Installer 按系统盘解析，不是写死的 C 盘。 -->
		<SetProperty Action="LockInstallFolder" Id="INSTALLFOLDER_INNER" Value="[ProgramFiles64Folder]$(var.Product)\" Before="CostFinalize" Sequence="both" />
		<!-- 管理代理在没有签名救援包时，用 RUSTDESK_AGENT_RECOVERY=1 加 INSTALLFOLDER=<保底目录> 把客户端装进固定的保底目录。
				 RUSTDESK_AGENT_RECOVERY=1 也出现在代理发起的正常升级和本地修复里（不带 INSTALLFOLDER），
				 所以只有传入的目录正好等于按系统盘算出的保底目录时才装进去，其余一律装到 Program Files。 -->
		<Property Id="INSTALLFOLDER" Secure="yes" />
		<SetProperty Id="RdFallbackFolder" Value="[CommonAppDataFolder]$(var.Product)\Client\$(var.Edition)\$(var.Product)" Before="SetRdFallbackFolderSlash" Sequence="both" />
		<SetProperty Id="RdFallbackFolderSlash" Value="[RdFallbackFolder]\" Before="LockInstallFolder" Sequence="both" />
		<SetProperty Action="LockRecoveryInstallFolder" Id="INSTALLFOLDER_INNER" Value="[RdFallbackFolderSlash]" After="LockInstallFolder" Sequence="both" Condition="RUSTDESK_AGENT_RECOVERY=&quot;1&quot; AND (INSTALLFOLDER~=RdFallbackFolder OR INSTALLFOLDER~=RdFallbackFolderSlash)" />

		<StandardDirectory Id="ProgramFiles6432Folder">
			<Directory Id="INSTALLFOLDER_INNER" Name="$(var.Product)" />
		</StandardDirectory>

		<StandardDirectory Id="CommonAppDataFolder">
			<Directory Id="App.Data.Folder" Name="$(var.Product)" />
		</StandardDirectory>

		<StandardDirectory Id="ProgramMenuFolder">
			<Directory Id="App.StartMenu" Name="$(var.Product)" />
		</StandardDirectory>

		<StandardDirectory Id="DesktopFolder" />
	</Fragment>
</Wix>
